
Commands :

	# Display Datases
		- show databases ;

	# Creating Databases
		- create database <name> ; | <name> ---> replace with actual database name

	# Delete Databases
		- drop Database <name> ;

	# USE database
		- Use <database name>

	# Display the current database
		- select database()
	
	# Making the tables
		- Create Table <tablename>
		(
			name Varchar(100),
			age INt
		)

	# display tables in the current database
		- show tables

	# display collums of a table
		- show columns from <database name>
			or 
		- desc <database name>

